# Settings for docker compose. Copy to .env and fill in; .env is never
# committed. Everything is optional, empty lines are fine.

# Address of SereS, used for links in e-mails and for passkeys.
PUBLIC_URL=https://beta.seres-chat.com
# Domain passkeys belong to (also works for its subdomains).
WEBAUTHN_RP_ID=seres-chat.com

# Where SereS listens. SERES_EXTRA_HOST=::1 also listens on IPv6, needed when
# a Cloudflare tunnel points to "localhost" on a server with IPv6.
HOST=127.0.0.1
PORT=2222
SERES_EXTRA_HOST=::1

# E-mail for password reset links. Without SMTP_HOST, reset by e-mail is off.
SMTP_HOST=localhost
SMTP_PORT=25
# none (local Postfix), starttls (port 587) or ssl (port 465)
SMTP_SECURITY=none
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="SereS <no-reply@seres-chat.com>"

# TURN server for voice calls (coturn with use-auth-secret).
TURN_URLS=turn:203.0.113.10:3478?transport=udp,turn:203.0.113.10:3478?transport=tcp
TURN_SECRET=

# Uptime heartbeat (e.g. Better Stack): called at startup and every 10 minutes.
URL=

# More hostnames allowed as request origin, comma separated (rarely needed).
SERES_ALLOWED_HOSTS=
